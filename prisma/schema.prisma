// SALESFLOW - E-Commerce Sales, Orders, Profit & Business Intelligence System
// Multi-Tenant, RBAC, Manufacturing, Inventory, CRM, Orders, Profit & AI

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id          String   @id @default(uuid())
  name        String
  currency    String   @default("USD")
  country     String   @default("US")
  logo        String?
  settings    String?  // JSON configuration: shipping defaults, commissions, AI prefs
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users              User[]
  products           Product[]
  batches            ProductionBatch[]
  inventoryMovements InventoryMovement[]
  offers             Offer[]
  customers          Customer[]
  orders             Order[]
  callLogs           CallLog[]
  activities         OrderActivity[]
  expenses           Expense[]
  notifications      Notification[]
  auditLogs          AuditLog[]
  aiSummaries        AiDailySummary[]
  productImages      ProductImage[]
  deliveryProviders  DeliveryProvider[]
  shippingBatches    ShippingBatch[]
  financialTransactions FinancialTransaction[]
  landingPages      LandingPage[]
  orderAddOns       OrderAddOn[]
  crmCompanies      CrmCompany[]
  crmContacts       CrmContact[]
  crmLeads          CrmLead[]
  crmDeals          CrmDeal[]
  crmTasks          CrmTask[]
  crmActivities     CrmActivity[]
  crmNotes          CrmNote[]
  crmInvoices       CrmInvoice[]
  roles             Role[]
  categories        Category[]
  whatsappConnections WhatsAppConnection[]
  whatsappConversations WhatsAppConversation[]
  whatsappMessages  WhatsAppMessage[]
  telegramSources   TelegramSource[]
  telegramMessages  TelegramMessage[]
  trackingPixels    TrackingPixel[]
  countries         Country[]
  stores            Store[]

  @@map("companies")
}

// ─── GLOBAL TRACKING PIXELS (additive) ───
// Centralized multi-platform tracking config (Meta / TikTok / Snapchat).
// pixelId is the ONLY stored value — no tokens, no secrets, no user JS.
// platform: META | TIKTOK | SNAPCHAT ; scope: GLOBAL | PUBLIC | LANDING_PAGES
// Loading/tracking code is 100% hard-coded in the app — never user-controlled.
model TrackingPixel {
  id        String   @id @default(uuid())
  companyId String
  platform  String   // META | TIKTOK | SNAPCHAT (allowlisted server-side)
  name      String
  pixelId   String   // validated per-platform (digits / alphanumeric / uuid)
  enabled   Boolean  @default(true)
  scope     String   @default("GLOBAL") // GLOBAL | PUBLIC | LANDING_PAGES
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, platform, pixelId])
  @@index([companyId, enabled, scope])
  @@index([companyId, platform, enabled])
  @@map("tracking_pixels")
}

model User {
  id                String    @id @default(uuid())
  companyId         String?
  email             String    @unique
  name              String
  passwordHash      String
  role              String    @default("PENDING_USER") // SUPER_ADMIN, COMPANY_ADMIN, MANAGER, MODERATOR, CONFIRMATION_AGENT, FOLLOW_UP_AGENT, SETTLEMENT_OFFICER, ACCOUNTANT, DELIVERY_MANAGER, PENDING_USER
  phone             String?
  avatar            String?
  commissionRate    Float     @default(0.0)
  status            String    @default("PENDING") // PENDING, ACTIVE, SUSPENDED, DISABLED
  tokenVersion      Int       @default(0)
  lastLoginAt       DateTime?
  assignedById      String?
  assignedAt        DateTime?
  resetToken        String?
  resetTokenExpires DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  company        Company?  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  assignedOrders Order[]   @relation("ModeratorOrders")
  claimedOrders  Order[]   @relation("OrderClaimer")
  ownedOrders    Order[]   @relation("OrderCurrentOwner")
  lockedOrders   Order[]   @relation("OrderLockHolder")
  assignedWork   Order[]   @relation("OrderAssignee")
  signedOrders   Order[]   @relation("OrderSignedBy")
  callLogs       CallLog[]
  auditLogs      AuditLog[]
  claimHistory   OrderClaimHistory[]
  statusLogs     OrderStatusLog[]
  contactAttempts OrderContactAttempt[]
  createdLandingPages LandingPage[] @relation("LandingPageCreator")
  confirmedOrders Order[]              @relation("OrderConfirmedBy")
  resolvedFollowUps Order[]            @relation("FollowUpResolvedBy")
  createdShippingBatches ShippingBatch[] @relation("ShippingBatchCreator")
  deliveryAgentAttempts DeliveryAttempt[] @relation("DeliveryAttemptAgent")
  financialTransactions FinancialTransaction[] @relation("FinanceTransactionActor")
  assignedDeliveryOrders Order[]      @relation("DeliveryAssignedBy")
  assignedBy     User?     @relation("UserAssigner", fields: [assignedById], references: [id])
  assignedUsers  User[]    @relation("UserAssigner")
  roleId            String?
  roleRef           Role? @relation(fields: [roleId], references: [id], onDelete: SetNull)
  permissionsVersion Int  @default(1)
  userPermissions UserPermission[]
  permissionsGranted UserPermission[] @relation("UserPermissionGranter")
  whatsappAssignedConversations WhatsAppConversation[] @relation("WhatsAppAssignee")
  crmContactOwners    CrmContact[]  @relation("CrmContactOwner")
  crmLeadAssignees    CrmLead[]     @relation("CrmLeadAssignee")
  crmDealAssignees    CrmDeal[]     @relation("CrmDealAssignee")
  crmTaskAssignees    CrmTask[]     @relation("CrmTaskAssignee")
  crmActivities       CrmActivity[] @relation("CrmActivityUser")
  crmNotes            CrmNote[]     @relation("CrmNoteUser")
  countryAccess       UserCountryAccess[]
  storeAccess         UserStoreAccess[]

  @@index([companyId])
  @@index([role])
  @@index([status])
  @@map("users")
}

model Product {
  id          String   @id @default(uuid())
  companyId   String
  name        String
  nameEn      String?
  sku         String
  description String?
  descriptionEn String?
  image       String?
  status      String   @default("ACTIVE") // ACTIVE, INACTIVE, OUT_OF_STOCK
  basePrice   Float    @default(0.0)
  categoryId  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company            Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category           Category?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  batches            ProductionBatch[]
  inventoryMovements InventoryMovement[]
  offers             Offer[]
  orders             Order[]
  orderItems         OrderItem[]
  landingPages       LandingPage[]
  recommendations    LandingPageRecommendation[]
  addOns             OrderAddOn[]
  images             ProductImage[]

  @@unique([companyId, sku])
  @@index([companyId])
  @@map("products")
}

model ProductImage {
  id         String   @id @default(uuid())
  companyId  String
  productId  String
  url        String
  storageKey String
  fileName   String
  mimeType   String
  fileSize   Int
  altText    String?
  isPrimary  Boolean  @default(false)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([companyId, productId])
  @@map("product_images")
}

model ProductionBatch {
  id                  String   @id @default(uuid())
  companyId           String
  productId           String
  batchNumber         String
  quantityProduced    Int
  quantitySold        Int      @default(0)
  quantityRemaining   Int
  manufacturingCost   Float    @default(0.0)
  packagingCost       Float    @default(0.0)
  rawMaterialCost     Float    @default(0.0)
  otherCosts          Float    @default(0.0)
  totalProductionCost Float    @default(0.0)
  costPerUnit         Float    @default(0.0)
  productionDate      DateTime @default(now())
  notes               String?
  status              String   @default("COMPLETED") // IN_PROGRESS, COMPLETED
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  company            Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product            Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventoryMovements InventoryMovement[]

  @@unique([companyId, batchNumber])
  @@index([companyId, productId])
  @@map("production_batches")
}

model InventoryMovement {
  id           String   @id @default(uuid())
  companyId    String
  productId    String
  batchId      String?
  type         String   // PRODUCTION, SALE, RETURN, MANUAL_ADJUSTMENT
  quantity     Int      // positive for addition, negative for deduction
  balanceAfter Int
  referenceId  String?  // orderId, batchId, etc.
  reason       String?
  createdById  String?
  createdAt    DateTime @default(now())

  company Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  batch   ProductionBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)

  @@index([companyId, productId])
  @@index([batchId])
  @@map("inventory_movements")
}

model Offer {
  id               String   @id @default(uuid())
  companyId        String
  productId        String
  name             String
  quantity         Int      @default(1)
  sellingPrice     Float
  discount         Float    @default(0.0)
  deliveryIncluded Boolean  @default(true)
  status           String   @default("ACTIVE") // ACTIVE, INACTIVE
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  orders  Order[]

  @@index([companyId, productId])
  @@map("offers")
}

model Customer {
  id                 String    @id @default(uuid())
  companyId          String
  fullName           String
  phone              String    // Normalized digits only for duplicate search
  rawPhone           String    // Display formatted
  altPhone           String?
  address            String
  city               String
  country            String    @default("EG")
  notes              String?
  totalOrders        Int       @default(0)
  confirmedOrders    Int       @default(0)
  deliveredOrders    Int       @default(0)
  cancelledOrders    Int       @default(0)
  totalPurchaseValue Float     @default(0.0)
  firstOrderDate     DateTime?
  lastOrderDate      DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  orders  Order[]
  whatsappConversations WhatsAppConversation[]

  @@unique([companyId, phone])
  @@index([companyId, phone])
  @@map("customers")
}

