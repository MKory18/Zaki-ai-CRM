  subtotal             Decimal? @db.Decimal(12, 2)
  discount             Decimal? @db.Decimal(12, 2)
  shippingRevenue      Decimal? @db.Decimal(12, 2)
  totalRevenue         Decimal? @db.Decimal(12, 2)
  productCost          Decimal? @db.Decimal(12, 2)
  packagingCost        Decimal? @db.Decimal(12, 2)
  advertisingCost      Decimal? @db.Decimal(12, 2)
  otherCost            Decimal? @db.Decimal(12, 2)
  refundAmount         Decimal? @db.Decimal(12, 2)
  grossProfit          Decimal? @db.Decimal(12, 2)
  netProfit            Decimal? @db.Decimal(12, 2)
  financeFinalizedAt   DateTime?
  financeFinalizedById String?
  source               String    @default("Manual") // Facebook Ads, TikTok, Instagram, WhatsApp, Manual, Website, Landing Page
  landingPageId        String?
  landingPageOfferId   String?
  freeQuantity         Int       @default(0) // gift units from a landing-page offer (additive)
  internalNotes        String?
  customerNotes        String?
  postponedUntil       DateTime?
  confirmedAt          DateTime?
  deliveredAt          DateTime?
  // Geo context (Stage 1). Nullable until every order-creation path writes it.
  countryId            String?
  storeId              String?
  // Stage 3: courier-facing reference, generated for EVERY order (POS, landing
  // page, Telegram). Read-only once set; sent in the courier reference field.
  merchantRef          String?
  // Snapshot of the offer's delivery policy: if ANY line includes delivery the
  // whole order does, and the fee is deducted from revenue instead of added.
  priceIncludesDelivery Boolean  @default(false)
