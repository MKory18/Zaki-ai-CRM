// SALESFLOW - PostgreSQL Production Schema
// For Docker, Docker Compose, Coolify, VPS deployment

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id          String   @id @default(uuid())
  name        String
  currency    String   @default("USD")
  country     String   @default("US")
  logo        String?
  settings    String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users              User[]
  products           Product[]
  batches            ProductionBatch[]
  inventoryMovements InventoryMovement[]
  offers             Offer[]
  customers          Customer[]
  orders             Order[]
  callLogs           CallLog[]
  activities         OrderActivity[]
  expenses           Expense[]
  notifications      Notification[]
  auditLogs          AuditLog[]
  aiSummaries        AiDailySummary[]

  @@map("companies")
}

model User {
  id             String    @id @default(uuid())
  companyId      String?
  email          String    @unique
  name           String
  passwordHash   String
  role           String    @default("MODERATOR")
  phone          String?
  avatar         String?
  commissionRate Float     @default(0.0)
  status         String    @default("ACTIVE")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  company        Company?  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  assignedOrders Order[]   @relation("ModeratorOrders")
  callLogs       CallLog[]
  auditLogs      AuditLog[]

  @@index([companyId])
  @@index([role])
  @@map("users")
}

model Product {
  id          String   @id @default(uuid())
  companyId   String
  name        String
  sku         String
  description String?  @db.Text
  image       String?
  status      String   @default("ACTIVE")
  basePrice   Float    @default(0.0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company            Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  batches            ProductionBatch[]
  inventoryMovements InventoryMovement[]
  offers             Offer[]
  orders             Order[]

  @@unique([companyId, sku])
  @@index([companyId])
  @@map("products")
}

model ProductionBatch {
  id                  String   @id @default(uuid())
  companyId           String
  productId           String
  batchNumber         String
  quantityProduced    Int
  quantitySold        Int      @default(0)
  quantityRemaining   Int
  manufacturingCost   Float    @default(0.0)
  packagingCost       Float    @default(0.0)
  rawMaterialCost     Float    @default(0.0)
  otherCosts          Float    @default(0.0)
  totalProductionCost Float    @default(0.0)
  costPerUnit         Float    @default(0.0)
  productionDate      DateTime @default(now())
  notes               String?  @db.Text
  status              String   @default("COMPLETED")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  company            Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product            Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventoryMovements InventoryMovement[]

  @@unique([companyId, batchNumber])
  @@index([companyId, productId])
  @@map("production_batches")
}

model InventoryMovement {
  id           String   @id @default(uuid())
  companyId    String
  productId    String
  batchId      String?
  type         String
  quantity     Int
  balanceAfter Int
  referenceId  String?
  reason       String?
  createdById  String?
  createdAt    DateTime @default(now())

  company Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  batch   ProductionBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)

  @@index([companyId, productId])
  @@index([batchId])
  @@map("inventory_movements")
}

model Offer {
  id               String   @id @default(uuid())
  companyId        String
  productId        String
  name             String
  quantity         Int      @default(1)
  sellingPrice     Float
  discount         Float    @default(0.0)
  deliveryIncluded Boolean  @default(true)
  status           String   @default("ACTIVE")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  orders  Order[]

  @@index([companyId, productId])
  @@map("offers")
}

model Customer {
  id                 String    @id @default(uuid())
  companyId          String
  fullName           String
  phone              String
  rawPhone           String
  altPhone           String?
  address            String
  city               String
  country            String    @default("EG")
  notes              String?   @db.Text
  totalOrders        Int       @default(0)
  confirmedOrders    Int       @default(0)
  deliveredOrders    Int       @default(0)
  cancelledOrders    Int       @default(0)
  totalPurchaseValue Float     @default(0.0)
  firstOrderDate     DateTime?
  lastOrderDate      DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  orders  Order[]

  @@unique([companyId, phone])
  @@index([companyId, phone])
  @@map("customers")
}

model Order {
  id                   String    @id @default(uuid())
  companyId            String
  orderNumber          String
  customerId           String
  productId            String
  offerId              String?
  quantity             Int       @default(1)
  sellingPrice         Float
  shippingCost         Float     @default(0.0)
  discountAmount       Float     @default(0.0)
  totalAmount          Float
  currency             String    @default("USD")
  moderatorId          String?
  moderatorCommission  Float     @default(0.0)
  estimatedCostOfGoods Float     @default(0.0)
  status               String    @default("NEW")
  source               String    @default("Manual")
  internalNotes        String?   @db.Text
  customerNotes        String?   @db.Text
  postponedUntil       DateTime?
  confirmedAt          DateTime?
  shippedAt            DateTime?
  deliveredAt          DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  company    Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer   Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product    Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  offer      Offer?          @relation(fields: [offerId], references: [id], onDelete: SetNull)
  moderator  User?           @relation("ModeratorOrders", fields: [moderatorId], references: [id], onDelete: SetNull)
  callLogs   CallLog[]
  activities OrderActivity[]

  @@unique([companyId, orderNumber])
  @@index([companyId, status])
  @@index([companyId, customerId])
  @@index([companyId, moderatorId])
  @@index([companyId, productId])
  @@map("orders")
}

model CallLog {
  id               String    @id @default(uuid())
  companyId        String
  orderId          String
  moderatorId      String
  callDate         DateTime  @default(now())
  result           String
  notes            String?   @db.Text
  nextFollowUpDate DateTime?
  createdAt        DateTime  @default(now())

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  moderator User    @relation(fields: [moderatorId], references: [id], onDelete: Cascade)

  @@index([companyId, orderId])
  @@index([moderatorId])
  @@map("call_logs")
}

model OrderActivity {
  id             String   @id @default(uuid())
  companyId      String
  orderId        String
  userId         String?
  action         String
  previousStatus String?
  newStatus      String?
  metadata       String?  @db.Text
  createdAt      DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([companyId, orderId])
  @@map("order_activities")
}

model Expense {
  id          String   @id @default(uuid())
  companyId   String
  title       String
  category    String
  amount      Float
  expenseDate DateTime @default(now())
  referenceId String?
  notes       String?  @db.Text
  createdById String?
  createdAt   DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, category])
  @@map("expenses")
}

model Notification {
  id        String   @id @default(uuid())
  companyId String
  userId    String?
  title     String
  message   String
  type      String
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, userId, isRead])
  @@map("notifications")
}

model AuditLog {
  id           String   @id @default(uuid())
  companyId    String
  userId       String?
  action       String
  entity       String
  entityId     String
  previousData String?  @db.Text
  newData      String?  @db.Text
  ipAddress    String?
  createdAt    DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([companyId, entity, entityId])
  @@map("audit_logs")
}

model AiDailySummary {
  id              String   @id @default(uuid())
  companyId       String
  date            String
  summaryText     String   @db.Text
  metricsJson     String   @db.Text
  observations    String?  @db.Text
  risks           String?  @db.Text
  recommendations String?  @db.Text
  createdAt       DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, date])
  @@index([companyId, date])
  @@map("ai_daily_summaries")
}
